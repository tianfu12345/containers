#!/bin/sh
HERMES=/home/ubuntu/.local/bin/hermes
$HERMES config set HERMES_CUSTOM_API_KEY "${HERMES_CUSTOM_API_KEY}"
$HERMES config set HERMES_CUSTOM_BASEURL "${HERMES_CUSTOM_BASEURL}"
$HERMES config set HERMES_CUSTOM_MODEL "${HERMES_CUSTOM_MODEL}"

# 集成参数落盘到 ~/.hermes/.env：.env 对所有入口可见，并覆盖容器 env 中的同名旧值
sync_env() {
  if [ -n "$2" ]; then
    $HERMES config set "$1" "$2"
  else
    $HERMES config unset "$1"
  fi
}
sync_env FIRECRAWL_API_URL "${FIRECRAWL_API_URL}"
sync_env SEARXNG_URL "${SEARXNG_URL}"
sync_env CAMOFOX_URL "${CAMOFOX_URL}"
sync_env OPENVIKING_ENDPOINT "${OPENVIKING_ENDPOINT}"
sync_env OPENVIKING_API_KEY "${OPENVIKING_API_KEY}"

# OpenViking 记忆后端开关
if [ "${OPENVIKING_ENABLED}" = "true" ]; then
  provider=openviking
else
  provider=builtin
fi
$HERMES config set memory.provider "$provider"

# webstack 集成：extract 走 crw（Firecrawl 兼容 /v1/scrape），search 走 SearXNG。
# 每个能力只看自己的 env：注入即启用，未注入则清除旧值，避免残留指向已删除的 Service。
if [ -n "${FIRECRAWL_API_URL}" ]; then
  $HERMES config set web.extract_backend firecrawl
else
  $HERMES config unset web.extract_backend
fi
if [ -n "${SEARXNG_URL}" ]; then
  $HERMES config set web.search_backend searxng
else
  $HERMES config unset web.search_backend
fi
# Browser Automation 走 camofox（Hermes 的 camofox 模式：cloud_provider=camofox + CAMOFOX_URL）
if [ -n "${CAMOFOX_URL}" ]; then
  $HERMES config set --force browser.cloud_provider camofox
else
  $HERMES config unset browser.cloud_provider
fi

$HERMES skills list
exec $HERMES gateway run
